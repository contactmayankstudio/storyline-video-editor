<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/funCameraRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Live Camera TextureView -->
    <TextureView
        android:id="@+id/cameraTextureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Live Filter & AR Overlay Canvas -->
    <com.video.engine.camera.CameraFilterOverlayView
        android:id="@+id/cameraFilterOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Controls Bar -->
    <LinearLayout
        android:id="@+id/cameraTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:id="@+id/cameraBackBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/launch_secondary_icon_chip"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/back_label"
                android:src="@drawable/ic_back_toolbar"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <!-- Night Flash Toggle -->
        <TextView
            android:id="@+id/cameraNightFlashBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/launch_secondary_icon_chip"
            android:gravity="center"
            android:text="💡"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Grid Toggle -->
        <TextView
            android:id="@+id/cameraGridBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/launch_secondary_icon_chip"
            android:gravity="center"
            android:text="▦"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:clickable="true"
            android:focusable="true" />

        <!-- Filter Style (Normal, Beauty, VHS 90s, Cyberpunk, Sunset) -->
        <TextView
            android:id="@+id/cameraFilterStyleBtn"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/launch_secondary_icon_chip"
            android:gravity="center"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="🎨 FX"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Lens Name Badge -->
        <TextView
            android:id="@+id/cameraLensNameBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/launch_count_chip_background"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="✨ Beauty Glow"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Video Recording Timer Badge -->
        <TextView
            android:id="@+id/cameraRecordingTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/launch_count_chip_background"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="🔴 REC 00:00"
            android:textColor="#FF4444"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/cameraFlipBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/launch_secondary_icon_chip"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Flip Camera"
                android:src="@drawable/ic_rotate_mirror"
                app:tint="#FFFFFF" />
        </FrameLayout>
    </LinearLayout>

    <!-- Bottom Controls Container -->
    <LinearLayout
        android:id="@+id/cameraBottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#88000000"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="24dp">

        <!-- Category Filter Pills (All, Comedy, Glasses, Hats, Animals, Effects) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/cameraCategoryContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp" />
        </HorizontalScrollView>

        <!-- Snapchat Style Circular Lens Carousel -->
        <HorizontalScrollView
            android:id="@+id/cameraLensScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/cameraFilterChipsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp" />
        </HorizontalScrollView>

        <!-- Photo / Video Mode Selector Switch -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/cameraPhotoModeBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📸 PHOTO"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#388BFD"
                android:paddingStart="14dp"
                android:paddingTop="5dp"
                android:paddingEnd="14dp"
                android:paddingBottom="5dp"
                android:background="@drawable/launch_count_chip_background"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/cameraVideoModeBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎥 VIDEO"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#8A99AD"
                android:paddingStart="14dp"
                android:paddingTop="5dp"
                android:paddingEnd="14dp"
                android:paddingBottom="5dp"
                android:layout_marginStart="8dp"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Snapchat-Style Pro Shutter Button -->
        <com.video.engine.camera.CameraShutterButton
            android:id="@+id/cameraShutterButton"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginBottom="4dp" />
    </LinearLayout>

    <!-- Floating Animated Lens Name Pill -->
    <TextView
        android:id="@+id/floatingLensPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="280dp"
        android:background="@drawable/launch_count_chip_background"
        android:paddingStart="20dp"
        android:paddingTop="9dp"
        android:paddingEnd="20dp"
        android:paddingBottom="9dp"
        android:text="✨ Lens Name"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:elevation="12dp"
        android:visibility="gone" />

    <!-- Zoom Indicator Pill (e.g. 1.0x, 2.5x) -->
    <TextView
        android:id="@+id/cameraZoomPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="80dp"
        android:background="@drawable/launch_count_chip_background"
        android:paddingStart="12dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp"
        android:text="1.0x"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Animated Swipe Filter Toast Pill -->
    <TextView
        android:id="@+id/cameraLensSwipeToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/launch_count_chip_background"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:text="✨ Filter Name"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:elevation="10dp"
        android:visibility="gone" />

</FrameLayout>
