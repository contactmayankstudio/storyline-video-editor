<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/funCameraRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Live Camera TextureView -->
    <TextureView
        android:id="@+id/cameraTextureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Live Filter & AR Overlay Canvas -->
    <com.video.engine.camera.CameraFilterOverlayView
        android:id="@+id/cameraFilterOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Controls Bar -->
    <LinearLayout
        android:id="@+id/cameraTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/camera_top_scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:id="@+id/cameraBackBtn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/camera_glass_button_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@string/back_label"
                android:src="@drawable/ic_back_toolbar"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <!-- Top Tool Actions (Music, Timer, Flash, Grid, Filter FX) -->
        <HorizontalScrollView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Live BGM Music Overlay Toggle -->
                <TextView
                    android:id="@+id/cameraMusicBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/camera_mode_pill_bg"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="🎵 Music"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Hands-Free Countdown Timer (Off -> 3s -> 10s) -->
                <TextView
                    android:id="@+id/cameraTimerBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/camera_glass_button_bg"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="⏱️ Off"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Night Flash Toggle (Warm Amber Studio Glow) -->
                <TextView
                    android:id="@+id/cameraNightFlashBtn"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/camera_glass_button_bg"
                    android:gravity="center"
                    android:text="💡"
                    android:textSize="16sp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Grid Toggle -->
                <TextView
                    android:id="@+id/cameraGridBtn"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/camera_glass_button_bg"
                    android:gravity="center"
                    android:text="▦"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:clickable="true"
                    android:focusable="true" />

                <!-- Filter Style (Normal, Beauty, VHS 90s, Cyberpunk, Sunset) -->
                <TextView
                    android:id="@+id/cameraFilterStyleBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/camera_mode_pill_bg"
                    android:gravity="center"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:text="🎨 FX"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Lens Name Badge -->
        <TextView
            android:id="@+id/cameraLensNameBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/launch_count_chip_background"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="✨ Beauty Glow"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Video Recording Timer Badge -->
        <TextView
            android:id="@+id/cameraRecordingTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/launch_count_chip_background"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp"
            android:text="🔴 REC 00:00"
            android:textColor="#FF4444"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/cameraFlipBtn"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/camera_glass_button_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="Flip Camera"
                android:src="@drawable/ic_rotate_mirror"
                app:tint="#FFFFFF" />
        </FrameLayout>
    </LinearLayout>

    <!-- Bottom Controls Container -->
    <LinearLayout
        android:id="@+id/cameraBottomContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/camera_bottom_scrim"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <!-- Category Filter Pills (All, Comedy, Glasses, Hats, Animals, Effects) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/cameraCategoryContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp" />
        </HorizontalScrollView>

        <!-- Snapchat Style Circular Lens Carousel -->
        <HorizontalScrollView
            android:id="@+id/cameraLensScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:overScrollMode="never"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/cameraFilterChipsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp" />
        </HorizontalScrollView>

        <!-- Photo / Video Mode Selector Switch -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:background="@drawable/camera_mode_pill_bg"
            android:padding="3dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/cameraPhotoModeBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📸 PHOTO"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp"
                android:background="@drawable/camera_active_mode_chip"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/cameraVideoModeBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎥 VIDEO"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#C8D1DC"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp"
                android:background="@null"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Snapchat-Style Pro Shutter Button -->
        <com.video.engine.camera.CameraShutterButton
            android:id="@+id/cameraShutterButton"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginBottom="4dp" />
    </LinearLayout>

    <!-- Floating Animated Lens Name Pill -->
    <TextView
        android:id="@+id/floatingLensPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="280dp"
        android:background="@drawable/launch_count_chip_background"
        android:paddingStart="20dp"
        android:paddingTop="9dp"
        android:paddingEnd="20dp"
        android:paddingBottom="9dp"
        android:text="✨ Lens Name"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:elevation="12dp"
        android:visibility="gone" />

    <!-- Zoom Indicator Pill (e.g. 1.0x, 2.5x) -->
    <TextView
        android:id="@+id/cameraZoomPill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="80dp"
        android:background="@drawable/launch_count_chip_background"
        android:paddingStart="12dp"
        android:paddingTop="5dp"
        android:paddingEnd="12dp"
        android:paddingBottom="5dp"
        android:text="1.0x"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Animated Swipe Filter Toast Pill -->
    <TextView
        android:id="@+id/cameraLensSwipeToast"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/launch_count_chip_background"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:text="✨ Filter Name"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:elevation="10dp"
        android:visibility="gone" />

    <!-- Instant Photo Shutter Flash Feedback -->
    <View
        android:id="@+id/cameraShutterFlash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"
        android:visibility="gone" />

    <!-- Warm Amber Screen Flash Overlay for Studio Selfie Glow -->
    <View
        android:id="@+id/cameraWarmAmberFlash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFF4E0"
        android:visibility="gone" />

    <!-- Hands-Free Animated Countdown Timer Overlay (3... 2... 1...) -->
    <FrameLayout
        android:id="@+id/cameraCountdownOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#44000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/cameraCountdownText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="3"
            android:textColor="#FFD700"
            android:textSize="110sp"
            android:textStyle="bold"
            android:shadowColor="#FF000000"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="24" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="160dp"
            android:text="⏱️ Tap anywhere to cancel timer"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp"
            android:background="@drawable/launch_count_chip_background"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp" />
    </FrameLayout>

</FrameLayout>
