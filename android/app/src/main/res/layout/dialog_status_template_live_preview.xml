<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/statusPreviewRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/dialog_status_preview_background"
    android:clipToPadding="false"
    android:padding="16dp">

    <ScrollView
        android:id="@+id/statusPreviewScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <!-- 1. Header Row: Category Badge, Title, Dismiss Button (X) -->
            <LinearLayout
                android:id="@+id/statusPreviewHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/statusPreviewCategoryBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/launch_count_chip_background"
                    android:paddingStart="10dp"
                    android:paddingTop="5dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:textColor="#D946EF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="TRENDING ✨" />

                <TextView
                    android:id="@+id/statusPreviewTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Viral Bass Drop Reels" />

                <FrameLayout
                    android:id="@+id/statusPreviewCloseBtn"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/launch_secondary_icon_chip"
                    android:clickable="true"
                    android:contentDescription="Close preview"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_close_preview"
                        app:tint="#8A99AD" />
                </FrameLayout>
            </LinearLayout>

            <!-- 2. Centered 9:16 Frame Embedding StatusTemplateLivePreviewView -->
            <FrameLayout
                android:id="@+id/statusPreviewContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center">

                <FrameLayout
                    android:id="@+id/statusPreviewFrame"
                    android:layout_width="230dp"
                    android:layout_height="370dp"
                    android:layout_gravity="center"
                    android:background="@drawable/status_preview_frame_background"
                    android:clipChildren="true"
                    android:clipToOutline="true"
                    android:elevation="8dp">

                    <com.video.engine.status.StatusTemplateLivePreviewView
                        android:id="@+id/statusLivePreviewView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />
                </FrameLayout>
            </FrameLayout>

            <!-- Floating 4-in-1 Quick Customizer Bar in Live Preview -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:orientation="vertical">

                <!-- Row 1: 📸 Swap Photo & ✏️ Put My Name -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/statusPreviewTestPhotoBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/launch_count_chip_background"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="📸"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/statusPreviewTestPhotoText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Swap Photo"
                                android:textColor="#388BFD"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/statusPreviewEditTextBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/launch_count_chip_background"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="✏️"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/statusPreviewEditText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Put My Name"
                                android:textColor="#FFD700"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>

                <!-- Row 2: 🎵 Change Music & ⏭️ Next Style -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/statusPreviewChangeMusicBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/launch_count_chip_background"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="🎵"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/statusPreviewChangeMusicText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Change Music"
                                android:textColor="#00F2FE"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/statusPreviewNextTemplateBtn"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/launch_count_chip_background"
                        android:clickable="true"
                        android:focusable="true"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="⏭️"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/statusPreviewNextTemplateText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="Next Style"
                                android:textColor="#D946EF"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- 3. Metadata Chips: Duration, Photos Required, BPM -->
            <LinearLayout
                android:id="@+id/statusPreviewChipsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="8dp"
                android:gravity="center"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/statusPreviewDurationChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/launch_count_chip_background"
                    android:paddingStart="9dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="4dp"
                    android:textColor="#388BFD"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    tools:text="⏱️ 12s" />

                <TextView
                    android:id="@+id/statusPreviewPhotosChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/launch_count_chip_background"
                    android:paddingStart="9dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="4dp"
                    android:textColor="#D946EF"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    tools:text="📸 4 Photos" />

                <TextView
                    android:id="@+id/statusPreviewBpmChip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/launch_count_chip_background"
                    android:paddingStart="9dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="9dp"
                    android:paddingBottom="4dp"
                    android:textColor="#00F2FE"
                    android:textSize="11.5sp"
                    android:textStyle="bold"
                    tools:text="🎵 128 BPM" />
            </LinearLayout>

            <!-- Template description -->
            <TextView
                android:id="@+id/statusPreviewDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:gravity="center"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="#8A99AD"
                android:textSize="11.5sp"
                tools:text="High energy beat synced status reel" />

            <!-- 4. Big Glowing Gradient Action Button ("📸 SELECT PHOTOS & CREATE STATUS") -->
            <FrameLayout
                android:id="@+id/statusPreviewCtaBtn"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/status_preview_cta_gradient_bg"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📸"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/statusPreviewCtaText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:letterSpacing="0.04"
                        android:text="SELECT PHOTOS &amp; CREATE STATUS"
                        android:textColor="#FFFFFF"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
