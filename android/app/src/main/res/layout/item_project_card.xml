<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/recent_project_card_background"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Icon Thumbnail -->
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/launch_secondary_icon_chip"
        android:padding="10dp">

        <ImageView
            android:id="@+id/projectCardIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_video_clip"
            app:tint="#388BFD" />
    </FrameLayout>

    <!-- Details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/projectCardName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FFFFFF"
            android:textSize="14.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/projectCardTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/project_card_tag"
                android:textColor="#388BFD"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • "
                android:textColor="#586069"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/projectCardDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#8A99AD"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Three-dot Context Button -->
    <FrameLayout
        android:id="@+id/projectCardMoreButton"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/home_nav_item_bg"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_more_vert"
            app:tint="#8A99AD" />
    </FrameLayout>

    <!-- Hidden compatibility views -->
    <TextView
        android:id="@+id/projectCardStatus"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/projectCardDelete"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

</LinearLayout>
