<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/startScreenOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/editor_root_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="28dp"
    android:paddingEnd="18dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/startEyebrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:letterSpacing="0.16"
        android:text="@string/start_eyebrow"
        android:textAllCaps="true"
        android:textColor="#64D8FF"
        android:textSize="10sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/startTopBannerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/start_top_ad_desc"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/startHeaderRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:background="@drawable/logo_app_background"
            android:padding="11dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_storyline_logo" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/startTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/start_title"
                android:textColor="#F5FAFF"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/startSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:lineSpacingExtra="1dp"
                android:maxLines="2"
                android:text="@string/start_subtitle"
                android:textColor="#9FB0BB"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/startCreateLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:text="@string/start_create_label"
        android:textColor="#D9E8F2"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="132dp"
        android:layout_marginTop="9dp"
        android:orientation="horizontal"
        android:weightSum="2">

        <LinearLayout
            android:id="@+id/startNewProjectButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:background="@drawable/launch_primary_action_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="15dp">

            <ImageView
                android:layout_width="31dp"
                android:layout_height="31dp"
                android:contentDescription="@string/start_primary_action"
                android:src="@drawable/ic_video_clip"
                android:tint="#FFF3E6" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="@string/start_primary_action"
                android:textColor="#FFF9F0"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/start_primary_caption"
                android:textColor="#FFE0C7"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/startPhotoEditorButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:background="@drawable/launch_photo_action_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="15dp">

            <ImageView
                android:layout_width="31dp"
                android:layout_height="31dp"
                android:contentDescription="@string/start_photo_editor_action"
                android:src="@drawable/ic_graphics"
                android:tint="#0D5D8F" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:text="@string/start_photo_editor_action"
                android:textColor="#072133"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/start_photo_editor_caption"
                android:textColor="#3B6173"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/startQuickLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="@string/start_quick_label"
        android:textColor="#D9E8F2"
        android:textSize="13sp"
        android:textStyle="bold" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginTop="8dp"
        android:clipToPadding="false"
        android:fillViewport="false"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/startOpenProjectButton"
                android:layout_width="132dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/launch_quick_action_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:lineSpacingExtra="1dp"
                android:text="@string/start_projects_action"
                android:textColor="#E8F4F8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/startImportMediaButton"
                android:layout_width="132dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/launch_quick_action_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:lineSpacingExtra="1dp"
                android:text="@string/start_import_action"
                android:textColor="#E8F4F8"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/startRecentProjectsEmptyText"
                android:layout_width="142dp"
                android:layout_height="56dp"
                android:layout_marginEnd="8dp"
                android:background="@drawable/launch_secondary_action_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:lineSpacingExtra="1dp"
                android:text="@string/recent_project_button_empty"
                android:textColor="#E8F4F8"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/startRecentPhotoText"
                android:layout_width="142dp"
                android:layout_height="56dp"
                android:background="@drawable/launch_secondary_action_background"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:lineSpacingExtra="1dp"
                android:text="@string/recent_photo_button_empty"
                android:textColor="#E8F4F8"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/startRecentWorkLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/recent_projects_label"
            android:textColor="#D9E8F2"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/startRecentSummaryText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/launch_count_chip_background"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="@string/recent_projects_empty"
            android:textColor="#AFC6D3"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/startRecentProjectsList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:paddingBottom="8dp"
        android:visibility="gone" />
</LinearLayout>
