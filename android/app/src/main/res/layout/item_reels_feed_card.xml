<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="440dp"
    android:layout_marginStart="4dp"
    android:layout_marginEnd="4dp"
    android:layout_marginBottom="16dp"
    android:background="@drawable/home_secondary_card_bg"
    android:clipToOutline="true"
    android:elevation="6dp">

    <!-- 1. 9:16 Model Human Portrait Photo View -->
    <ImageView
        android:id="@+id/reelsCardPhoto"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <!-- 2. Dynamic Gradient Tint Overlay -->
    <View
        android:id="@+id/reelsCardBg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.32"
        android:background="@drawable/status_preview_cta_gradient_bg" />

    <!-- 3. Ambient Dark Gradient Scrim (top & bottom readable overlays) -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/reels_feed_card_scrim" />

    <!-- Center Kinetic Lyric Typography -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <TextView
            android:id="@+id/reelsCardCenterEmoji"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/launch_status_icon_chip"
            android:gravity="center"
            android:text="🔥"
            android:textSize="28sp" />

        <TextView
            android:id="@+id/reelsCardLyricText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:letterSpacing="0.04"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="3"
            android:shadowRadius="8"
            android:text="WAIT FOR THE DROP 🔥"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reelsCardSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="3D ZOOM PRO • BEAT SYNC"
            android:textColor="#FFE500"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Top Bar with Community & Sound Badges -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <TextView
            android:id="@+id/reelsCardCommunityBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/launch_count_chip_background"
            android:paddingStart="9dp"
            android:paddingTop="4dp"
            android:paddingEnd="9dp"
            android:paddingBottom="4dp"
            android:text="✨ STORYLINE COMMUNITY"
            android:textColor="#FFFFFF"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Sound Preview Pill (Tappable to toggle audio) -->
        <LinearLayout
            android:id="@+id/reelsCardSoundPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/launch_count_chip_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp">

            <TextView
                android:id="@+id/reelsCardSoundIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎵"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/reelsCardSoundTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:maxWidth="130dp"
                android:singleLine="true"
                android:text="Attitude Bass Drop"
                android:textColor="#00F2FE"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Action & Info Area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/reelsCardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6"
            android:text="Storyline 3D Zoom Pro 🔥"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/reelsCardDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:shadowColor="#AA000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="4"
            android:text="Viral Storyline 3D depth zoom with camera roll, beat drop shake, and high-impact bass cuts."
            android:textColor="#D0E0FF"
            android:textSize="11.5sp" />

        <!-- 1-Tap Use Template CTA Button -->
        <LinearLayout
            android:id="@+id/reelsCardUseBtn"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/home_primary_card_bg"
            android:clickable="true"
            android:elevation="4dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_status_maker"
                app:tint="#FFFFFF" />

            <TextView
                android:id="@+id/reelsCardUseBtnText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="⚡ Use Template (1-Photo Ready)"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
