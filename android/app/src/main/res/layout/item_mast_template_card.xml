<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="270dp"
    android:layout_margin="5dp"
    android:clickable="true"
    android:focusable="true">

    <androidx.cardview.widget.CardView
        android:id="@+id/mastCardRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:cardBackgroundColor="#131722"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:cardMaxElevation="6dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- 1. Background Dynamic Gradient Layer -->
            <View
                android:id="@+id/mastCardBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/reels_feed_card_scrim" />

            <!-- 2. Center Kinetic Lyric Text Preview -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/mastCardEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="32sp"
                    tools:text="🔥" />

                <TextView
                    android:id="@+id/mastCardLyricText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="6"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="WAIT FOR THE DROP 🔥" />
            </LinearLayout>

            <!-- 3. Top Badges: Photo count & Viral Usage -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp">

                <TextView
                    android:id="@+id/mastCardPhotoPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:background="@drawable/launch_count_chip_background"
                    android:paddingStart="7dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="3dp"
                    android:text="📸 1 Photo"
                    android:textColor="#FFFFFF"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mastCardUsageBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/launch_count_chip_background"
                    android:paddingStart="7dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="7dp"
                    android:paddingBottom="3dp"
                    android:text="🔥 1.5M Uses"
                    android:textColor="#FFE500"
                    android:textSize="9.5sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <!-- 4. Bottom Info & CTA Gradient Button Scrim -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/reels_feed_card_scrim"
                android:orientation="vertical"
                android:paddingStart="8dp"
                android:paddingTop="14dp"
                android:paddingEnd="8dp"
                android:paddingBottom="10dp">

                <!-- Title & BPM waveform row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/mastCardTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        tools:text="Storyline 3D Zoom Pro" />

                    <TextView
                        android:id="@+id/mastCardBpm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="130 BPM"
                        android:textColor="#00F2FE"
                        android:textSize="9.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Live Waveform bar indicator -->
                <LinearLayout
                    android:id="@+id/mastCardWaveformBars"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="7dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_weight="1"
                        android:background="#388BFD" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="2dp"
                        android:layout_weight="1"
                        android:background="#00F2FE" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="2dp"
                        android:layout_marginStart="2dp"
                        android:layout_weight="1"
                        android:background="#FF0844" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="4dp"
                        android:layout_marginStart="2dp"
                        android:layout_weight="1"
                        android:background="#FFE500" />
                    <View
                        android:layout_width="0dp"
                        android:layout_height="3dp"
                        android:layout_marginStart="2dp"
                        android:layout_weight="1"
                        android:background="#D946EF" />
                </LinearLayout>

                <!-- Glowing Gradient Make Status CTA Button -->
                <FrameLayout
                    android:id="@+id/mastCardMakeBtn"
                    android:layout_width="match_parent"
                    android:layout_height="30dp"
                    android:background="@drawable/status_preview_cta_gradient_bg"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:id="@+id/mastCardMakeBtnText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:text="⚡ MAKE STATUS"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </FrameLayout>
            </LinearLayout>

        </FrameLayout>
    </androidx.cardview.widget.CardView>
</FrameLayout>
