rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isVerifiedGoogleReader() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == "google.com";
    }

    function validStringField(key, maxSize) {
      return request.resource.data[key] is string
        && request.resource.data[key].size() > 0
        && request.resource.data[key].size() <= maxSize;
    }

    function isSafeInstallationWrite(docId) {
      return request.resource.data.keys().hasOnly([
          "installationId",
          "sessionId",
          "updatedAt",
          "updatedAtMs",
          "appState",
          "currentScreen",
          "lastAction",
          "hasProjectContent",
          "isPlaying",
          "versionName",
          "versionCode",
          "packageName",
          "deviceModel",
          "deviceManufacturer",
          "androidVersion",
          "source",
        ])
        && request.resource.data.installationId == docId
        && validStringField("installationId", 64)
        && validStringField("sessionId", 64)
        && validStringField("currentScreen", 48)
        && validStringField("lastAction", 120)
        && validStringField("versionName", 32)
        && validStringField("packageName", 80)
        && validStringField("deviceModel", 80)
        && validStringField("deviceManufacturer", 80)
        && validStringField("androidVersion", 24)
        && request.resource.data.updatedAtMs is int
        && request.resource.data.versionCode is int
        && request.resource.data.hasProjectContent is bool
        && request.resource.data.isPlaying is bool
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.source == "android-client"
        && request.resource.data.appState in ["launching", "foreground", "background"];
    }

    function isSafeOpsReportWrite(docId) {
      return request.resource.data.keys().hasOnly([
          "reportId",
          "reportType",
          "description",
          "source",
          "sessionId",
          "currentScreen",
          "lastAction",
          "hasProjectContent",
          "isPlaying",
          "versionName",
          "versionCode",
          "packageName",
          "deviceModel",
          "deviceManufacturer",
          "androidVersion",
          "recentUiTaps",
          "createdAtMs",
          "createdAt",
          "status",
          "stallMs",
        ])
        && request.resource.data.reportId == docId
        && validStringField("reportId", 64)
        && validStringField("reportType", 24)
        && validStringField("description", 800)
        && validStringField("source", 48)
        && validStringField("sessionId", 64)
        && validStringField("currentScreen", 48)
        && validStringField("lastAction", 120)
        && validStringField("versionName", 32)
        && validStringField("packageName", 80)
        && validStringField("deviceModel", 80)
        && validStringField("deviceManufacturer", 80)
        && validStringField("androidVersion", 24)
        && request.resource.data.hasProjectContent is bool
        && request.resource.data.isPlaying is bool
        && request.resource.data.versionCode is int
        && request.resource.data.createdAtMs is int
        && request.resource.data.createdAt is timestamp
        && request.resource.data.status == "open"
        && request.resource.data.recentUiTaps is list
        && request.resource.data.recentUiTaps.size() <= 24
        && (
          !("stallMs" in request.resource.data)
          || request.resource.data.stallMs is int
        );
    }

    function isSafeGitHubIssueMap() {
      return request.resource.data.githubIssue is map
        && request.resource.data.githubIssue.keys().hasOnly([
          "number",
          "url",
          "title",
        ])
        && request.resource.data.githubIssue.number is int
        && request.resource.data.githubIssue.url is string
        && request.resource.data.githubIssue.url.size() > 0
        && request.resource.data.githubIssue.url.size() <= 400
        && request.resource.data.githubIssue.title is string
        && request.resource.data.githubIssue.title.size() > 0
        && request.resource.data.githubIssue.title.size() <= 240;
    }

    function isSafeOpsReportAdminUpdate(docId) {
      return isVerifiedGoogleReader()
        && request.resource.data.reportId == docId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "githubIssue",
          "updatedAt",
          "triagedAt",
          "triagedBy",
        ])
        && request.resource.data.status in ["open", "triaged"]
        && (
          !("updatedAt" in request.resource.data)
          || request.resource.data.updatedAt is timestamp
        )
        && (
          !("triagedAt" in request.resource.data)
          || request.resource.data.triagedAt is timestamp
        )
        && (
          !("triagedBy" in request.resource.data)
          || (
            request.resource.data.triagedBy is string
            && request.resource.data.triagedBy.size() > 0
            && request.resource.data.triagedBy.size() <= 120
          )
        )
        && (
          !("githubIssue" in request.resource.data)
          || isSafeGitHubIssueMap()
        );
    }

    function isAllowedOpsCommand(command) {
      return command in [
        "sync_health",
        "show_home",
        "open_export",
        "open_media",
        "open_text",
        "play",
        "pause",
        "open_save",
        "open_aspect_ratio",
        "open_audio",
        "open_overlay",
        "open_layer",
      ];
    }

    function isSafeOpsCommandCreate(installationId, commandId) {
      return isVerifiedGoogleReader()
        && request.resource.data.keys().hasOnly([
          "commandId",
          "targetInstallationId",
          "command",
          "source",
          "issuedBy",
          "createdAtMs",
          "createdAt",
          "updatedAtMs",
          "updatedAt",
          "status",
        ])
        && request.resource.data.commandId == commandId
        && request.resource.data.targetInstallationId == installationId
        && validStringField("commandId", 96)
        && validStringField("targetInstallationId", 96)
        && validStringField("command", 48)
        && validStringField("source", 32)
        && validStringField("issuedBy", 120)
        && isAllowedOpsCommand(request.resource.data.command)
        && request.resource.data.source == "admin-panel"
        && request.resource.data.createdAtMs is int
        && request.resource.data.updatedAtMs is int
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.status == "queued";
    }

    function isSafeOpsCommandClientUpdate(installationId, commandId) {
      return request.resource.data.commandId == commandId
        && request.resource.data.targetInstallationId == installationId
        && request.resource.data.command == resource.data.command
        && request.resource.data.source == resource.data.source
        && request.resource.data.issuedBy == resource.data.issuedBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdAtMs == resource.data.createdAtMs
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "updatedAt",
          "updatedAtMs",
          "handledBySessionId",
          "handledBySource",
          "resultMessage",
          "completedAt",
        ])
        && request.resource.data.status in ["running", "completed", "failed"]
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAtMs is int
        && (
          !("handledBySessionId" in request.resource.data)
          || (
            request.resource.data.handledBySessionId is string
            && request.resource.data.handledBySessionId.size() > 0
            && request.resource.data.handledBySessionId.size() <= 96
          )
        )
        && (
          !("handledBySource" in request.resource.data)
          || request.resource.data.handledBySource == "android-client"
        )
        && (
          !("resultMessage" in request.resource.data)
          || (
            request.resource.data.resultMessage is string
            && request.resource.data.resultMessage.size() <= 240
          )
        )
        && (
          !("completedAt" in request.resource.data)
          || request.resource.data.completedAt is timestamp
        );
    }

    function isSafeDeviceChannelAdminWrite(installationId) {
      return isVerifiedGoogleReader()
        && request.resource.data.keys().hasOnly([
          "commandId",
          "targetInstallationId",
          "command",
          "source",
          "issuedBy",
          "createdAtMs",
          "createdAt",
          "updatedAtMs",
          "updatedAt",
          "status",
          "handledBySessionId",
          "handledBySource",
          "resultMessage",
          "completedAt",
        ])
        && request.resource.data.targetInstallationId == installationId
        && validStringField("commandId", 96)
        && validStringField("targetInstallationId", 96)
        && validStringField("command", 48)
        && validStringField("source", 32)
        && validStringField("issuedBy", 120)
        && isAllowedOpsCommand(request.resource.data.command)
        && request.resource.data.source == "admin-panel"
        && request.resource.data.createdAtMs is int
        && request.resource.data.updatedAtMs is int
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.status == "queued";
    }

    function isSafeDeviceChannelClientUpdate(installationId) {
      return request.resource.data.targetInstallationId == installationId
        && request.resource.data.source == resource.data.source
        && request.resource.data.command == resource.data.command
        && request.resource.data.commandId == resource.data.commandId
        && request.resource.data.issuedBy == resource.data.issuedBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdAtMs == resource.data.createdAtMs
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status",
          "updatedAt",
          "updatedAtMs",
          "handledBySessionId",
          "handledBySource",
          "resultMessage",
          "completedAt",
        ])
        && request.resource.data.status in ["running", "completed", "failed"]
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedAtMs is int
        && (
          !("handledBySessionId" in request.resource.data)
          || (
            request.resource.data.handledBySessionId is string
            && request.resource.data.handledBySessionId.size() > 0
            && request.resource.data.handledBySessionId.size() <= 96
          )
        )
        && (
          !("handledBySource" in request.resource.data)
          || request.resource.data.handledBySource == "android-client"
        )
        && (
          !("resultMessage" in request.resource.data)
          || (
            request.resource.data.resultMessage is string
            && request.resource.data.resultMessage.size() <= 240
          )
        )
        && (
          !("completedAt" in request.resource.data)
          || request.resource.data.completedAt is timestamp
        );
    }

    match /ops_installations/{installationId} {
      allow get, list: if isVerifiedGoogleReader();
      allow create, update: if isSafeInstallationWrite(installationId);
      allow delete: if false;

      match /commands/{commandId} {
        allow get, list: if true;
        allow create: if isSafeOpsCommandCreate(installationId, commandId);
        allow update: if isSafeOpsCommandClientUpdate(installationId, commandId);
        allow delete: if false;
      }
    }

    match /ops_device_channels/{installationId} {
      allow get, list: if true;
      allow create: if isSafeDeviceChannelAdminWrite(installationId);
      allow update: if isSafeDeviceChannelAdminWrite(installationId) || isSafeDeviceChannelClientUpdate(installationId);
      allow delete: if false;
    }

    match /crash_fixes/{issueId} {
      allow get, list: if isVerifiedGoogleReader();
      allow write: if false;
    }

    match /ops_crashes/{issueId} {
      allow get, list: if isVerifiedGoogleReader();
      allow write: if false;
    }

    match /ops_reports/{reportId} {
      allow get, list: if isVerifiedGoogleReader();
      allow create: if isSafeOpsReportWrite(reportId);
      allow update: if isSafeOpsReportAdminUpdate(reportId);
      allow delete: if false;
    }
  }
}
